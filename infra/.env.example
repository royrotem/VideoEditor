# Copy to `.env` at the repo root and fill in the values you need.
# All keys correspond to fields on `app.core.config.Settings`.

# --- General ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
MODEL_ORCHESTRATOR=claude-opus-4-7
MODEL_CREATIVE_DIRECTOR=claude-opus-4-7
MODEL_PLANNER=claude-sonnet-4-6
MODEL_SPECIALIST=claude-sonnet-4-6
MODEL_LIGHTWEIGHT=claude-haiku-4-5-20251001

# --- Postgres (matches infra/docker-compose.yml defaults) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=videoeditor
POSTGRES_PASSWORD=videoeditor
POSTGRES_DB=videoeditor

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Celery ---
# CELERY_EAGER=true runs render tasks in the API process (default for dev).
# Set to false in production so rendering moves to a separate worker;
# start the worker with `make backend-worker`.
CELERY_EAGER=true

# --- MinIO / S3 ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=videoeditor
S3_SECRET_KEY=videoeditor
S3_REGION=us-east-1
S3_BUCKET_ASSETS=assets
S3_BUCKET_RENDERS=renders
S3_USE_SSL=false
